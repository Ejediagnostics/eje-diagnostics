<style>
/* Layout: one reading column of case files; each case = thumbnails strip, then problem / build / proof / fixes */
:root{
  --bg:#0B111C; --surface:#121A28; --line:#25314A; --fg:#E9EEF5; --muted:#97A3B7; --accent:#FF6B57; --accent-ink:#0B111C; --ok:#4FC28B;
  --f-display:'Sora',ui-sans-serif,system-ui,sans-serif; --f-body:'IBM Plex Sans',ui-sans-serif,system-ui,sans-serif; --f-mono:'IBM Plex Mono',ui-monospace,monospace;
  color-scheme:dark;
}
@media (prefers-color-scheme: light){:root:not([data-theme="dark"]){--bg:#F5F6F9;--surface:#FFFFFF;--line:#DCE1EA;--fg:#141B27;--muted:#56627A;--accent:#D9452F;--accent-ink:#FFFFFF;--ok:#1F8A57;color-scheme:light}}
:root[data-theme="light"]{--bg:#F5F6F9;--surface:#FFFFFF;--line:#DCE1EA;--fg:#141B27;--muted:#56627A;--accent:#D9452F;--accent-ink:#FFFFFF;--ok:#1F8A57;color-scheme:light}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--f-body);font-size:16px;line-height:1.6}
.wrap{max-width:1040px;margin:0 auto;padding-block:48px 72px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;line-height:1.1;margin:0}
h1{font-size:clamp(34px,5.4vw,56px);font-weight:800;letter-spacing:-.01em}
h1 em,h2 em{font-style:normal;color:var(--accent)}
h2{font-size:clamp(26px,3.6vw,36px);font-weight:700}
h3{font-size:15px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
p{margin:0;max-width:68ch}
.tag{display:inline-block;background:var(--accent);color:var(--accent-ink);font-weight:600;font-size:14px;padding:4px 10px;border-radius:6px}
.mono{font-family:var(--f-mono);font-size:14px}
.muted{color:var(--muted)}
header{display:grid;gap:18px;padding-bottom:36px;border-bottom:1px solid var(--line)}
.who{font-size:15px;color:var(--muted)}
.who b{color:var(--fg);font-weight:600}
.principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:8px}
.pr{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.pr b{display:block;font-family:var(--f-display);font-size:17px;margin-bottom:4px}
.pr span{color:var(--muted);font-size:15px}
nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
nav a{color:var(--fg);text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:6px 14px;font-size:14px}
nav a:hover,nav a:focus-visible{border-color:var(--accent);color:var(--accent);outline:none}
section.case{padding-top:56px;display:grid;gap:22px}
.strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.strip img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px;border:1px solid var(--line);display:block}
.cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px}
.block{display:grid;gap:10px;min-width:0}
ul{margin:0;padding-left:20px}
li{margin:4px 0}
.steps{counter-reset:s;list-style:none;padding:0}
.steps li{counter-increment:s;position:relative;padding-left:34px;margin:8px 0}
.steps li::before{content:counter(s);position:absolute;left:0;top:1px;width:22px;height:22px;border-radius:50%;border:1px solid var(--accent);color:var(--accent);font-family:var(--f-mono);font-size:12px;display:flex;align-items:center;justify-content:center}
.who-does{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:13px;border-radius:999px;padding:3px 10px;border:1px solid var(--line);color:var(--muted)}
.chip.code{border-color:var(--accent);color:var(--accent)}
.tbl{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:15px}
th,td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:none}
th{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600}
td.num{font-family:var(--f-mono);white-space:nowrap;color:var(--ok);font-variant-numeric:tabular-nums}
.stack{font-size:14px;color:var(--muted)}
footer{margin-top:64px;padding-top:24px;border-top:1px solid var(--line);display:grid;gap:8px;font-size:15px;color:var(--muted)}
@media (max-width:760px){.principles,.cols{grid-template-columns:1fr}.strip{grid-template-columns:1fr 1fr}.strip img:last-child{grid-column:1/-1}}
@media (prefers-reduced-motion:no-preference){nav a{transition:border-color .15s,color .15s}}
</style>
